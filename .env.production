# Production Environment Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/job_portal_prod?retryWrites=true&w=majority
REDIS_URL=redis://username:password@your-redis-host:6379

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production-minimum-32-characters

# Email Service Configuration (Gmail example)
EMAIL_SERVICE=gmail
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASS=your-gmail-app-password

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880